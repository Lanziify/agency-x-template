{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noImplicitAny": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // "@*": ["./*"],
      "@payload-config": ["./config/payload.config.ts"],
      "@app/*": ["./app/(app)/*"],
      "@collections/*": ["./app/collections/*"],
      "@blocks/*": ["./app/blocks/*"],
      "@components/*": ["./components/*"],
      "@features/*": ["./features/*"],
      "@lib/*": ["./lib/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts", "globals.d.ts"],
  "exclude": ["node_modules"]
}
