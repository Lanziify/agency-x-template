{
  "plugins": ["prettier-plugin-tailwindcss", "@trivago/prettier-plugin-sort-imports"],
  "printWidth": 140,
  "singleQuote": true,
  "bracketSameLine": true,
  "semi": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "importOrder": [
    "^react",
    "^next",
    "^payload",
    "@payload/(.*)$",
    "@payload-config",
    "@payloadcms/(.*)$",
    "@app/(.*)$",
    "@collections/(.*)$",
    "@components/(.*)$",
    "@features/(.*)/components/(.*)$",
    "@features/(.*)/lib/(.*)$",
    "@features/(.*)/queries/(.*)$",
    "@features/(.*)/service/(.*)$",
    "@lib/(.*)$",
    "@config/(.*)$",
    "^[./]"
  ],
  "importOrderSortSpecifiers": true
}
