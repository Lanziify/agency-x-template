NODE_ENV=development

APP_NAME=Agency-X

# Database Credentials
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=my-db

DB_HOST=localhost
DB_PORT=5432

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

ADMINER_PORT=8080

# PAYLOADCMS Credential
PAYLOAD_SECRET=secret

# Bucket Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agency-x-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Admin Email Credential
ADMIN_FROM_NAME="Agency X Support"
ADMIN_FROM_MAIL=info@agency-x.lanziify.site
ADMIN_NO_REPLY_MAIL=no-reply@agency-x.lanziify.site

# SendGrid Credentials
SENDGRID_API_KEY=

# SMTP Credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=agency-x
SMTP_PASS=agency-x-smptp

# Google reCaptcha V3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=